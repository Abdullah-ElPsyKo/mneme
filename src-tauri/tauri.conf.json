{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mneme",
  "version": "0.3.1",
  "identifier": "app.mneme.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": "npm run desktop:prepare",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
      "capabilities": ["bootstrap"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A local home for your memory",
    "longDescription": "Private notes, decisions, projects, evidence, search and a knowledge graph. Your Markdown and SQLite stay on your computer. AI is optional.",
    "publisher": "Mneme",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/mneme-core"],
    "resources": {
      "resources/core/": "core/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "Mneme",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "allowDowngrades": false
    }
  }
}
